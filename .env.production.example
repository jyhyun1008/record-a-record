# Copy this to .env.production on the SERVER (never commit the real file).
# DATABASE_URL is set in docker-compose.yml already — don't duplicate it here.

AUTH_SECRET=""
# canonical public URL — without this, behind a reverse proxy Auth.js can
# misdetect the host (e.g. redirecting to 0.0.0.0:3000 instead of your domain)
AUTH_URL="https://record.gongran.studio"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
ALLOWED_GITHUB_LOGIN=""

SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

GENIUS_ACCESS_TOKEN=""
