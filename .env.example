ALLOWED_GITHUB_LOGIN=""

# --- Spotify (Client Credentials flow, https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Genius (https://genius.com/api-clients) ---
GENIUS_ACCESS_TOKEN=""
